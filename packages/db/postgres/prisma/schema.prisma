// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =======================
// USER & AUTH
// =======================

model User {
  id    String  @id @default(uuid())
  email String  @unique
  name  String?

  passwordHash String? // optional for OAuth users

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces Workspace[]
}

// =======================
// WORKSPACE (TENANT)
// =======================

model Workspace {
  id   String @id @default(uuid())
  name String

  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id])

  createdAt DateTime @default(now())

  connections   Connection[]
  organizations Organization[]
  pipelines     Pipeline[]

  @@index([ownerUserId])
}

// =======================
// INTEGRATION (GLOBAL)
// =======================

model Integration {
  id       String @id @default(uuid())
  name     String @unique // Xero, Quickbooks, etc
  authType String // oauth2, api_key

  airbyteSourceDefinitionId String

  createdAt DateTime @default(now())

  connections Connection[]
}

// =======================
// CONNECTION (OAUTH)
// =======================

model Connection {
  id   String @id @default(uuid())
  name String

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id])

  accessToken  String // encrypt in production
  refreshToken String?
  expiresAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]

  @@index([workspaceId])
  @@index([integrationId])
}

// =======================
// ORGANIZATION (FROM SaaS)
// =======================

model Organization {
  id String @id @default(uuid())

  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id])

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  externalOrgId String // ID from Xero, Quickbooks, etc
  name          String
  metadata      Json?

  createdAt DateTime @default(now())

  pipelines Pipeline[]

  // Prevent duplicate orgs per connection
  @@unique([connectionId, externalOrgId])
  @@index([workspaceId])
}

// =======================
// PIPELINE (AIRBYTE SYNC)
// =======================

model Pipeline {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  airbyteConnectionId String // Airbyte connection ID

  status   PipelineStatus
  lastSync DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs PipelineRun[]

  @@unique([organizationId])
  @@index([workspaceId])
}

// =======================
// PIPELINE RUNS (OBSERVABILITY)
// =======================

model PipelineRun {
  id String @id @default(uuid())

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])

  status PipelineRunStatus

  startedAt  DateTime
  finishedAt DateTime?

  error String?

  createdAt DateTime @default(now())

  @@index([pipelineId])
}

// =======================
// ENUMS
// =======================

enum PipelineStatus {
  ACTIVE
  PAUSED
  FAILED
}

enum PipelineRunStatus {
  RUNNING
  SUCCESS
  FAILED
}
